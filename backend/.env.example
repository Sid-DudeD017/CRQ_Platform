# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real credentials.

# --- Database ---
# Leave unset for local dev - defaults to a local SQLite file
# (crq_db.sqlite3). Once Neon is set up, set either name below (both work):
# DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require
# NEON_DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require

# --- Auth (POST /api/auth/login, required for POST /api/audit) ---
# Generate a real secret before deploying: `openssl rand -hex 32`
SECRET_KEY=dev-only-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Blockchain audit trail (AuditLedger.sol) ---
# Leave all three unset for local dev against `npx hardhat node` - the
# defaults below already match Hardhat's local defaults. For a HOSTED
# deployment (Render, etc.) that can't run its own Hardhat node, deploy to
# Sepolia instead (see the README's Deployment section and
# blockchain/.env.example):
#   cd blockchain && npx hardhat run scripts/deploy.js --network sepolia
# That command writes all three of these into THIS file for you - copy the
# same three values into your Render service's env vars afterward.
#
# WEB3_PROVIDER_URL=https://ethereum-sepolia-rpc.publicnode.com
# CONTRACT_ADDRESS=<printed by deploy.js>
# DEPLOYER_PRIVATE_KEY=<the same wallet that deployed - see blockchain/.env.example>
