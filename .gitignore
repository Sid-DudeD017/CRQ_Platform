# Node.js / Next.js
frontend/node_modules/
frontend/.next/
frontend/.swc/
frontend/out/
frontend/tsconfig.tsbuildinfo
npm-debug.log*

# Hardhat (blockchain) - node_modules and compiler build output, both
# regenerated locally by `npm install` + `npx hardhat compile`/`deploy`
blockchain/node_modules/
blockchain/artifacts/
blockchain/cache/

# Copy of the compiled ABI deploy.js drops next to the backend - also
# regenerated by every `npx hardhat run scripts/deploy.js`
backend/AuditLedger.json

# Editor/tool backup files
*.bak

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
env/
.env
.env.save
.venv

# Database
*.sqlite3
*.db
crq_db.sqlite3
crq_platform.db

# Vector DB
ai-agent/chroma_data/

# Logs (uvicorn.log, frontend/dev.log, npm-debug.log* already covered above)
*.log

# Stray local test/auth output (e.g. `curl -o login.json` while testing
# auth locally) - never intentionally produced by the app itself
login.json

# OS
.DS_Store
Thumbs.db

# Stray tool-session artifact occasionally dropped in repo root
:memory:.ses
